# ================================================================
# ENVIRONMENT VARIABLES - STOREX BACKEND
# ================================================================
# Copy this file to .env and configure with your values

# MongoDB Connection String (REQUIRED)
# Format: mongodb://localhost:27017/storex
# OR for MongoDB Atlas: mongodb+srv://username:password@cluster.mongodb.net/storex
MONGO_URI=mongodb://localhost:27017/storex

# JWT Secret Key (REQUIRED)
# Generate a random string for production
JWT_SECRET=your-secret-key-change-this-in-production

# Server Port (OPTIONAL)
# Default: 5000
PORT=5000

# Frontend URL (OPTIONAL for CORS)
# Use * for development, specific URL for production
# Example: http://localhost:3000
FRONTEND_URL=*
